{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Grind",
  "version": "0.1.0",
  "identifier": "dev.localgrind.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Grind",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 David Tran and the Local Grind contributors. Licensed under MIT OR Apache-2.0.",
    "resources": {
      "../../assets/problems.db": "problems.db",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
